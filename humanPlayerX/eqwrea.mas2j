/*
    tresEnRaya — Humano (X) vs IA (O)
    ----------------------------------
    xplayer ha sido eliminado: el humano juega directamente desde la UI.
    oplayer es el agente IA con Alpha-Beta.
*/

MAS eqwrea {

    environment: example.Env(10)

    agents:
        oplayer iaPlayer.asl [beliefs="mySymbol(o) "];

    aslSourcePath: "src/agt";
}